{{define "subject"}}Finish your registration{{end}}

{{define "body"}}
<!doctype html>
<html>

<head>
  <meta name="viewport" content="width=device-width" />
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <title>Finish your registration</title>
</head>

<body>
  <p>Hi {{.Username}},</p>
  <p>Thanks for signing up for Social Media! To finish your registration, please click the link below:</p>
  <p><a href="{{.ActivationURL}}">Activate your account</a></p>
  <p>If you did not sign up for Social Media, please ignore this email.</p>
</body>

</html>

</html>

{{end}}